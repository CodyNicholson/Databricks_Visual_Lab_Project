# Copy to .env (git-ignored) and fill in. pipeline-run.sh creates .env from this file
# when it is missing. Add the lab's own settings (API keys, tuning knobs) below.

# Optional: only used by pipeline-run.sh when TUNNEL_TOKEN is not set globally on the server
TUNNEL_TOKEN=

# Optional: a real Databricks workspace for the "Databricks SDK & Jobs" demo. Leave empty to run it
# offline (the SDK builds and validates the requests without sending them).
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Rate limits for live workspace calls (the site is public)
LIVE_RUNS_PER_MINUTE=5
LIVE_RUNS_PER_HOUR=60
